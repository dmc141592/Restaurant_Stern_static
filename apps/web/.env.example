# Copy to .env.local for local development (Vite loads .env.local automatically).
# Base URL of the backend API, no trailing slash.
VITE_API_BASE_URL=http://localhost:4000

# Public URL this frontend is served from (used for canonical links etc.).
VITE_SITE_URL=http://localhost:5173

# Optional: enable Cloudflare Turnstile on the reservation form.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
