# Copy this file to .env and fill in real values for local development.
# Never commit the resulting .env file.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# postgres://<user>:<password>@<host>:<port>/<database>
# Port 5433 matches compose.yaml's host mapping (chosen to avoid clashing
# with a locally installed PostgreSQL, which commonly occupies 5432).
DATABASE_URL=postgres://sternen:sternen_dev_password@localhost:5433/sternen

BUSINESS_TIME_ZONE=Europe/Zurich

# Public URL of the frontend (used to build links, e.g. in emails).
FRONTEND_URL=http://localhost:5173

# Comma separated list of origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

# Long random string used to sign/verify session and CSRF secrets.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

SESSION_TTL_SECONDS=43200

# Bootstrap-only: used by `npm run admin:bootstrap` to create the first admin.
# Not read at server runtime.
ADMIN_INITIAL_EMAIL=admin@sternen-albisrieden.ch
ADMIN_INITIAL_PASSWORD=change-me-immediately

# Mailbox that receives new-reservation notifications.
RESTAURANT_NOTIFICATION_EMAIL=reservation@sternen-albisrieden.ch

# SMTP: point at a local Mailpit (see compose.yaml) for development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sternen-albisrieden.ch
SMTP_FROM_NAME=Restaurant Sternen Albisrieden

# Base URL used to build the links inside reservation-confirmation emails.
# Must point at the frontend's action page, e.g. https://sternen-albisrieden.ch/reservationsaktion
ACTION_LINK_BASE_URL=http://localhost:5173/reservationsaktion

# Peppers: server-side secret material mixed into hashes before storage.
# Generate independently from SESSION_SECRET.
POS_API_KEY_PEPPER=replace-with-a-long-random-string-min-32-chars
TOKEN_HASH_PEPPER=replace-with-a-long-random-string-min-32-chars

LOG_LEVEL=info

# How many days a completed (rejected/cancelled/past-confirmed) reservation's
# personal data is retained before the retention job anonymises it.
PERSONAL_DATA_RETENTION_DAYS=730

# Optional bot protection for the public reservation form.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
