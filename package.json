{
  "name": "restaurant-sternen-albisrieden",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Website, Online-Reservationssystem und Adminbereich fuer das Restaurant Sternen Albisrieden",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-local-dev.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:shared": "npm run build --workspace packages/shared",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api && npm run test --workspace apps/web",
    "test:api": "npm run test --workspace apps/api",
    "test:api:unit": "npm run test:unit --workspace apps/api",
    "test:api:integration": "npm run test:integration --workspace apps/api",
    "test:web": "npm run test --workspace apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspace packages/shared && npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:reset": "npm run db:reset --workspace apps/api",
    "admin:bootstrap": "npm run admin:bootstrap --workspace apps/api",
    "apikey:create": "npm run apikey:create --workspace apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
